# Database Connection (Provide your production database URL here)
# Append ?connection_limit=N (and optionally &pool_timeout=SECONDS) once you
# know your MySQL plan's real max_connections — e.g. on Hostinger, check
# hPanel > Databases > (your DB) for the connection cap, then set this to a
# fraction of it (leave headroom for phpMyAdmin/other apps sharing the DB).
# Until then this runs with Prisma's un-capped default, which is the gap the
# consolidation plan's Decision 3 flags: public-site traffic and internal
# CRM traffic currently share one uncapped pool on one process
# (PROCESS_ROLE=all, see server.ts) — a public traffic spike can exhaust
# connections the CRM needs. Setting this explicitly is the cheap mitigation
# available now, before PROCESS_ROLE is actually split into separate
# processes on the Hostinger KVM2 VPS.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?connection_limit=10"

# PROCESS_ROLE — 'all' (default, current behavior), 'internal', 'public', or
# 'portal'. Lets this same codebase run as separate deployments later without
# a rewrite — see server.ts's PROCESS_ROLE block and the consolidation plan.
PROCESS_ROLE="all"

# Security Secrets (Must be at least 32 random characters for production)
JWT_ACCESS_SECRET="generate_a_secure_random_string_here_for_access_tokens"
JWT_REFRESH_SECRET="generate_a_secure_random_string_here_for_refresh_tokens"
# Public-website visitor account tokens (WebsiteAccount) — kept separate from
# the employee secrets above so a visitor's token can never work against an
# internal/employee route.
WEBSITE_JWT_SECRET="generate_a_secure_random_string_here_for_website_account_tokens"
QR_HMAC_SECRET="generate_a_secure_random_string_here_for_qr_codes"
ENCRYPTION_KEY="generate_a_secure_random_32_byte_string_for_kyc_encryption"

# Server & Environment Config
NODE_ENV="production"
PORT=3000
TZ="Asia/Kolkata"

# File storage driver: "local" (default, writes to UPLOAD_ROOT — Render
# requires a Persistent Disk mounted at this path for uploads to survive
# restarts), "sftp" (uploads to a remote host over SFTP — most managed
# hosting, e.g. Hostinger, exposes this), or "ftp" (plaintext FTP, kept for
# backward compatibility — prefer sftp).
STORAGE_DRIVER="local"
UPLOAD_ROOT="./uploads"

# SFTP credentials (only used when STORAGE_DRIVER="sftp"). Get these from your
# hosting control panel (e.g. Hostinger > Files > FTP Accounts also shows the
# SFTP host/port, or hPanel > Advanced > SSH Access). Use either
# SFTP_PASSWORD or SFTP_PRIVATE_KEY (+ SFTP_PASSPHRASE if the key has one) —
# not both.
SFTP_HOST=""
SFTP_PORT="22"
SFTP_USERNAME=""
SFTP_PASSWORD=""
SFTP_PRIVATE_KEY=""
SFTP_PASSPHRASE=""
# Directory on the remote server uploads are written under, e.g. "/home/USER/public_html/uploads"
SFTP_REMOTE_BASE_PATH=""
# The public URL that SFTP_REMOTE_BASE_PATH is served from, e.g. "https://cdn.yourdomain.com/uploads"
SFTP_PUBLIC_BASE_URL=""

# Legacy plaintext-FTP credentials (only used when STORAGE_DRIVER="ftp")
FTP_HOST=""
FTP_PORT="21"
FTP_USERNAME=""
FTP_PASSWORD=""
FTP_REMOTE_BASE_PATH=""
FTP_PUBLIC_BASE_URL=""

# Frontend / CORS allowed URL (Replace with your actual live frontend domain)
APP_URL="https://rscrm.radharealhomeproperties.com"

# --- Frontend environment variables (used during build process) ---
# VITE_API_ORIGIN points to the backend API base URL
VITE_API_ORIGIN="https://api.radharealhomeproperties.com"

# VITE_MEDIA_ORIGIN points to the server where uploaded files and media are hosted
# This allows separating the API server from the static media server
VITE_MEDIA_ORIGIN="https://cdn.radharealhomeproperties.com"

# Web Push Notifications
VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:admin@radharealhomes.com"

# External Integrations
SONTHILLU_LOCAL_API_KEY="your_api_key_here"

# Customer Portal Integration (Optional)
PORTAL_API_URL=""
CRM_PORTAL_SECRET=""
PORTAL_CRM_SECRET=""
PORTAL_WORKER_ENABLED="false"
PORTAL_POLL_INTERVAL_MS="30000"

# AI-powered natural-language property search (public website). Leave
# OPENAI_API_KEY empty to disable. Any OpenAI-compatible provider works —
# e.g. Google Gemini's free tier via its OpenAI-compatible endpoint:
#   OPENAI_MODEL="gemini-2.5-flash-lite"
#   OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""